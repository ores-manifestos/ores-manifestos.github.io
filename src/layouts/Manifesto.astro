---
import Base from './Base.astro';

const { frontmatter } = Astro.props;

const modules = import.meta.glob('../pages/manifestos/*.md', { eager: true });
const all = Object.values(modules)
  .map((m: any) => m.frontmatter)
  .sort((a: any, b: any) => a.number - b.number);

const index = all.findIndex((m: any) => m.slug === frontmatter.slug);
const prev = index > 0 ? all[index - 1] : null;
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : null;
---

<Base title={`${frontmatter.title} — ORES Manifestos`} description={frontmatter.tagline}>
  <article class="article">
    <div class="inner">
      <p class="eyebrow">Manifesto {String(frontmatter.number).padStart(2, '0')}</p>
      <h1>{frontmatter.title}</h1>
      <p class="tagline">{frontmatter.tagline}</p>
      <div class="prose">
        <slot />
      </div>
      <nav class="pager">
        {prev ? <a href={`/manifestos/${prev.slug}`}>&larr; {prev.title}</a> : <span></span>}
        {next ? <a href={`/manifestos/${next.slug}`}>{next.title} &rarr;</a> : <span></span>}
      </nav>
    </div>
  </article>
</Base>
